# Base local (PostgreSQL instalado en la máquina). En Vercel: cadena de Neon.
DATABASE_URL="postgresql://pasaporte:pasaporte@localhost:5433/pasaporte_beta?schema=public"
# Secreto para firmar cookies de sesión (mínimo 32 caracteres)
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32+"
# URL pública usada en el QR (sin barra final)
PUBLIC_BASE_URL="http://localhost:3000"
# Opcional: si está definido, los archivos se guardan en Vercel Blob; si no, en ./uploads
BLOB_READ_WRITE_TOKEN=""
